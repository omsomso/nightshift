{
  "name": "nightshift-supervisor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local-first supervisor for unattended coding agents",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "NIGHTSHIFT_HOME=\"$(mktemp -d)\" NIGHTSHIFT_INSTALL_ROOT=\"$(mktemp -d)\" node --test",
    "demo": "node src/cli.js demo",
    "status": "node src/cli.js status",
    "smoke": "node src/smoke.js",
    "codex:smoke": "node src/smoke.js codex",
    "claude:smoke": "node src/smoke.js claude",
    "repair:check": "node src/repair-check.js"
  }
}
